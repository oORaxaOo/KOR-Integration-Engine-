{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KIE Integration Event v1",
  "description": "Public JSON envelope for events exchanged by independent KOR engines and trusted host adapters.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "schema_version",
    "event_type",
    "producer_engine",
    "producer_version",
    "occurred_at",
    "recorded_at",
    "epistemic_status",
    "sensitivity",
    "allowed_consumers",
    "payload",
    "evidence_refs",
    "parent_event_ids",
    "session_id",
    "task_id",
    "correlation_id",
    "expires_at",
    "hop_count",
    "idempotency_key",
    "verification"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "const": 1
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,95}$",
      "maxLength": 96
    },
    "producer_engine": {
      "enum": [
        "critical_thinking",
        "reliability",
        "evidence",
        "emotion",
        "hermes_host"
      ]
    },
    "producer_version": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "epistemic_status": {
      "enum": [
        "observed",
        "hypothesis",
        "under_review",
        "verified",
        "refuted",
        "unresolved"
      ]
    },
    "sensitivity": {
      "enum": [
        "public",
        "internal",
        "restricted"
      ]
    },
    "allowed_consumers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "critical_thinking",
          "reliability",
          "evidence",
          "emotion"
        ]
      }
    },
    "payload": {
      "type": "object",
      "description": "JSON object, limited to 65536 UTF-8 bytes by the KIE runtime."
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "parent_event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "hop_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "verification": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verifier",
            "criteria",
            "scope",
            "verified_at",
            "evidence_refs"
          ],
          "properties": {
            "verifier": {
              "type": "string",
              "minLength": 1
            },
            "criteria": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "verified_at": {
              "type": "string",
              "format": "date-time"
            },
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "epistemic_status": {
            "enum": [
              "verified",
              "refuted"
            ]
          }
        },
        "required": [
          "epistemic_status"
        ]
      },
      "then": {
        "properties": {
          "verification": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "verification": {
            "type": "null"
          }
        }
      }
    }
  ]
}
